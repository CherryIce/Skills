<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta id="page-description" name="description" content="Privacy Policy for [[APP_NAME]]">
    <title>Privacy Policy — [[APP_NAME]]</title>
    <link rel="stylesheet" href="styles.css">
    <script src="site.js" defer></script>
  </head>
  <body
    data-title-en="Privacy Policy — [[APP_NAME]]"
    data-title-zh="隐私政策 — [[APP_NAME]]"
    data-description-en="Privacy Policy for [[APP_NAME]]"
    data-description-zh="[[APP_NAME]] 隐私政策"
  >
    <header class="site-header">
      <a class="brand" href="index.html" data-local-page><span>[[APP_NAME]]</span></a>
      <nav aria-label="Primary navigation">
        <a href="index.html" data-local-page><span data-lang="en">Product</span><span data-lang="zh">产品</span></a>
        <a href="mailto:[[SUPPORT_EMAIL]]"><span data-lang="en">Support</span><span data-lang="zh">支持</span></a>
      </nav>
      <div class="language-switch" role="group" aria-label="Language / 语言">
        <button type="button" data-language-option="en">EN</button>
        <button type="button" data-language-option="zh">中文</button>
      </div>
    </header>

    <main class="policy">
      <article data-lang="en">
        <p class="eyebrow">Effective [[EFFECTIVE_DATE_EN]]</p>
        <h1>Privacy Policy</h1>
        <p>[[PRIVACY_SUMMARY_EN]]</p>
        <h2>Information and data</h2><p>[[DATA_PRACTICES_EN]]</p>
        <h2>Device permissions</h2><p>[[PERMISSIONS_EN]]</p>
        <h2>Network and third-party services</h2><p>[[NETWORK_AND_SERVICES_EN]]</p>
        <h2>Storage, retention, and deletion</h2><p>[[STORAGE_RETENTION_DELETION_EN]]</p>
        <h2>Exports and sharing</h2><p>[[EXPORTS_AND_SHARING_EN]]</p>
        <h2>Children's privacy</h2><p>[[CHILDREN_EN]]</p>
        <h2>Changes to this policy</h2><p>[[POLICY_CHANGES_EN]]</p>
        <h2>Contact</h2><p>[[OPERATOR]] · <a href="mailto:[[SUPPORT_EMAIL]]">[[SUPPORT_EMAIL]]</a></p>
      </article>

      <article data-lang="zh">
        <p class="eyebrow">生效日期：[[EFFECTIVE_DATE_ZH]]</p>
        <h1>隐私政策</h1>
        <p>[[PRIVACY_SUMMARY_ZH]]</p>
        <h2>信息与数据</h2><p>[[DATA_PRACTICES_ZH]]</p>
        <h2>设备权限</h2><p>[[PERMISSIONS_ZH]]</p>
        <h2>网络与第三方服务</h2><p>[[NETWORK_AND_SERVICES_ZH]]</p>
        <h2>存储、保留与删除</h2><p>[[STORAGE_RETENTION_DELETION_ZH]]</p>
        <h2>导出与共享</h2><p>[[EXPORTS_AND_SHARING_ZH]]</p>
        <h2>儿童隐私</h2><p>[[CHILDREN_ZH]]</p>
        <h2>政策变更</h2><p>[[POLICY_CHANGES_ZH]]</p>
        <h2>联系我们</h2><p>[[OPERATOR]] · <a href="mailto:[[SUPPORT_EMAIL]]">[[SUPPORT_EMAIL]]</a></p>
      </article>
    </main>

    <footer><a href="index.html" data-local-page><span data-lang="en">Back to [[APP_NAME]]</span><span data-lang="zh">返回 [[APP_NAME]]</span></a></footer>
